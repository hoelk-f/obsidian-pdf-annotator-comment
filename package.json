{
  "name": "remark-my-words",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node -e \"process.env.NODE_ENV='production'; import('./esbuild.config.mjs')\"",
    "typecheck": "tsc --noEmit",
    "test": "node tests/model.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:release": "npm run build && npm run check:release && node scripts/package-release.mjs",
    "version": "node scripts/version.mjs",
    "release": "node scripts/release.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:preview": "node scripts/release.mjs --dry-run",
    "lint": "eslint src --max-warnings=0",
    "test:build": "node tests/build.test.mjs",
    "check:build": "node scripts/check-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "esbuild": "0.23.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  },
  "description": "Read, annotate, and connect PDF passages on a visual canvas in Obsidian.",
  "author": "Florian Hölken",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoelk-f/remark-my-words.git"
  },
  "homepage": "https://github.com/hoelk-f/remark-my-words#readme",
  "bugs": {
    "url": "https://github.com/hoelk-f/remark-my-words/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "eslint-plugin-obsidianmd": {
      "obsidian": "$obsidian"
    }
  }
}
